<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <Platform>x64</Platform>
    <OutputName>NativeBotSetup-0.1.0-beta.1</OutputName>
    <AcceptEula>wix7</AcceptEula>
    <SuppressIces>ICE61;ICE91</SuppressIces>
    <Cultures>ru-RU</Cultures>
    <PayloadDir Condition="'$(PayloadDir)' == ''">$(MSBuildThisFileDirectory)..\bin\NativeBot-win-x64</PayloadDir>
    <DefineConstants>PayloadDir=$(PayloadDir)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
  </ItemGroup>
</Project>
