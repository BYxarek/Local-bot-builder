<Window x:Class="NativeBot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Конструктор Telegram-ботов" Height="720" Width="1180" MinHeight="560" MinWidth="820"
        WindowState="Maximized">
  <Grid Background="{DynamicResource PageBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="72" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Padding="24,0" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Native Bot Create" Style="{StaticResource AppBarTitleText}" />
          <TextBlock Text="Конструктор и управление Telegram-ботами" Style="{StaticResource SupportingText}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Обновить" Click="Refresh_Click" Style="{StaticResource MaterialDesignFlatButton}">
            <Button.ContentTemplate>
              <DataTemplate><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Refresh" Margin="0,0,8,0" /><TextBlock Text="Обновить" /></StackPanel></DataTemplate>
            </Button.ContentTemplate>
          </Button>
          <Button Click="PauseAll_Click" Style="{StaticResource MaterialDesignOutlinedButton}">
            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="PauseCircleOutline" Margin="0,0,8,0" /><TextBlock Text="Приостановить всех" /></StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <TabControl x:Name="MainTabs" Grid.Row="1" Margin="24,8,24,24">
      <TabItem>
        <TabItem.Header><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="RobotOutline" Margin="0,0,8,0" /><TextBlock Text="Боты" /></StackPanel></TabItem.Header>
        <Grid Background="{DynamicResource PageBackgroundBrush}" Style="{StaticResource AnimatedPage}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Margin="4,20,4,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Мои боты" Style="{StaticResource TitleText}" />
              <TextBlock Text="Откройте бота двойным щелчком, чтобы перейти к сценариям и аудитории." Style="{StaticResource SupportingText}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Добавить бота" Click="AddBot_Click" Style="{StaticResource MaterialDesignRaisedButton}" VerticalAlignment="Center">
              <Button.ContentTemplate>
                <DataTemplate><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Plus" Margin="0,0,8,0" /><TextBlock Text="Добавить бота" /></StackPanel></DataTemplate>
              </Button.ContentTemplate>
            </Button>
          </Grid>
          <materialDesign:Card Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="BotsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      MouseDoubleClick="BotsGrid_MouseDoubleClick" Margin="8">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="2*" />
                <DataGridTextColumn Header="Состояние" Binding="{Binding Status}" Width="2*" />
                <DataGridTextColumn Header="Пользователи" Binding="{Binding KnownUsers}" Width="*" />
                <DataGridTextColumn Header="Последнее событие" Binding="{Binding LastEventAt}" Width="2*" />
              </DataGrid.Columns>
            </DataGrid>
          </materialDesign:Card>
        </Grid>
      </TabItem>

      <TabItem x:Name="SettingsTab">
        <TabItem.Header><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CogOutline" Margin="0,0,8,0" /><TextBlock Text="Настройки" /></StackPanel></TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource PageBackgroundBrush}" Style="{StaticResource AnimatedPage}">
          <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,20,0,0">
            <TextBlock Text="Настройки" Style="{StaticResource TitleText}" Margin="4,0,0,4" />
            <TextBlock Text="Внешний вид и запуск приложения" Style="{StaticResource SupportingText}" Margin="4,0,0,20" />

            <materialDesign:Card Style="{StaticResource Card}" Margin="4,0,4,16">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <materialDesign:PackIcon Kind="PaletteOutline" Width="24" Height="24" Margin="0,0,12,0" />
                  <TextBlock Text="Внешний вид" Style="{StaticResource SectionText}" VerticalAlignment="Center" />
                </StackPanel>
                <ComboBox x:Name="ThemeBox" Width="300" HorizontalAlignment="Left" Margin="0,20,0,0"
                          SelectionChanged="ThemeBox_SelectionChanged">
                  <ComboBoxItem Tag="light" Content="Светлая" />
                  <ComboBoxItem Tag="dark" Content="Тёмная" />
                </ComboBox>
              </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Style="{StaticResource Card}" Margin="4,0,4,16">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <materialDesign:PackIcon Kind="Power" Width="24" Height="24" Margin="0,0,12,0" />
                  <TextBlock Text="Запуск" Style="{StaticResource SectionText}" VerticalAlignment="Center" />
                </StackPanel>
                <CheckBox x:Name="AutoStartBox" Margin="0,20,0,0" Content="Запускать вместе с Windows в системном трее" Click="AutoStart_Click" />
                <TextBlock Margin="32,8,0,0" Style="{StaticResource SupportingText}"
                           Text="Приложение запускается без окна и продолжает управлять ботами в фоне." />
              </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Style="{StaticResource Card}" Margin="4,0,4,16">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <materialDesign:PackIcon Kind="InformationOutline" Width="24" Height="24" Margin="0,0,12,0" />
                  <TextBlock Text="О приложении" Style="{StaticResource SectionText}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="VersionTextBlock" Margin="36,12,0,0" Style="{StaticResource SupportingText}" />
              </StackPanel>
            </materialDesign:Card>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
