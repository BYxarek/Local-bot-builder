<Window x:Class="NativeBot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Конструктор Telegram-ботов" Height="620" Width="980" MinHeight="450" MinWidth="760">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
      <TextBlock Text="Мои боты" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
      <Button Content="Добавить бота" Click="AddBot_Click" Margin="24,0,0,0" />
      <Button Content="Обновить" Click="Refresh_Click" />
      <Button Content="Приостановить всех" Click="PauseAll_Click" />
    </StackPanel>
    <DataGrid x:Name="BotsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="BotsGrid_MouseDoubleClick">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="2*" />
        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="2*" />
        <DataGridTextColumn Header="Состояние" Binding="{Binding Status}" Width="2*" />
        <DataGridTextColumn Header="Пользователи" Binding="{Binding KnownUsers}" Width="*" />
        <DataGridTextColumn Header="Последнее событие" Binding="{Binding LastEventAt}" Width="2*" />
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" Foreground="DimGray" Text="Откройте бота двойным щелчком." />
  </DockPanel>
</Window>
