<Window x:Class="NativeBot.App.BotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Бот" Height="780" Width="1280" MinHeight="620" MinWidth="980" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Background="{DynamicResource PageBackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Border Padding="24,0" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="BotTitle" Style="{StaticResource AppBarTitleText}" />
          <TextBlock x:Name="RuntimeStatus" Style="{StaticResource SupportingText}" Margin="0,3,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Click="Stop_Click" Style="{StaticResource MaterialDesignOutlinedButton}">
            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="StopCircleOutline" Margin="0,0,8,0" /><TextBlock Text="Остановить" /></StackPanel>
          </Button>
          <Button Click="Start_Click" Style="{StaticResource MaterialDesignRaisedButton}">
            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="PlayCircleOutline" Margin="0,0,8,0" /><TextBlock Text="Запустить" /></StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <TabControl x:Name="BotTabs" Grid.Row="1" Margin="20,8,20,20">
      <TabItem>
        <TabItem.Header><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ViewDashboardEditOutline" Margin="0,0,8,0" /><TextBlock Text="Конструктор" /></StackPanel></TabItem.Header>
        <Grid Background="{DynamicResource PageBackgroundBrush}" Style="{StaticResource AnimatedPage}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="22*" MinWidth="210" />
            <ColumnDefinition Width="48*" MinWidth="420" />
            <ColumnDefinition Width="30*" MinWidth="280" />
          </Grid.ColumnDefinitions>

          <materialDesign:Card Style="{StaticResource Card}" Padding="12" Margin="0,16,12,0">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <StackPanel Margin="8">
                <TextBlock Text="Блоки" Style="{StaticResource SectionText}" />
                <TextBlock Text="Добавьте шаг в сценарий" Style="{StaticResource SupportingText}" Margin="0,3,0,0" />
              </StackPanel>
              <ListBox x:Name="PaletteList" Grid.Row="1" DisplayMemberPath="Label" MouseDoubleClick="AddNode_Click" Margin="0,8" />
              <Button Grid.Row="2" Content="Добавить блок" Click="AddNode_Click" Style="{StaticResource MaterialDesignRaisedButton}" />
            </Grid>
          </materialDesign:Card>

          <materialDesign:Card Grid.Column="1" Style="{StaticResource Card}" Padding="12" Margin="0,16,12,0">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <Grid Margin="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="FlowNameBox" Text="Новый сценарий" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Content="Проверить" Click="Validate_Click" Style="{StaticResource MaterialDesignFlatButton}" />
                  <Button Content="Сохранить" Click="SaveDraft_Click" />
                  <Button Content="Опубликовать" Click="Publish_Click" Style="{StaticResource MaterialDesignRaisedButton}" />
                </StackPanel>
              </Grid>
              <ListBox x:Name="NodesList" Grid.Row="1" DisplayMemberPath="Name" SelectionChanged="NodesList_SelectionChanged" Margin="4,12,4,4" />
            </Grid>
          </materialDesign:Card>

          <materialDesign:Card Grid.Column="2" Style="{StaticResource Card}" Padding="16" Margin="0,16,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="Настройки блока" Style="{StaticResource SectionText}" />
                <TextBox x:Name="ContentBox" AcceptsReturn="True" MinHeight="128" Margin="0,20,0,0"
                         materialDesign:HintAssist.Hint="Содержимое" TextChanged="ContentBox_TextChanged" />
                <TextBlock Text="Введите {, чтобы увидеть переменные" Style="{StaticResource SupportingText}" Margin="4,4,4,0" />
                <ListBox x:Name="VariableHints" Height="96" Visibility="Collapsed" MouseDoubleClick="VariableHints_MouseDoubleClick" Margin="0,8" />
                <Expander Header="Дополнительно" Margin="0,12,0,0">
                  <StackPanel Margin="8">
                    <CheckBox Content="Отключить уведомление" Margin="0,6" />
                    <CheckBox Content="Защитить содержимое" Margin="0,6" />
                    <TextBox materialDesign:HintAssist.Hint="Тема сообщения" Margin="0,8,0,0" />
                  </StackPanel>
                </Expander>
                <Button Content="Применить к блоку" Click="ApplyNode_Click" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,16,0,8" />
                <ListBox x:Name="ValidationList" MinHeight="100" MaxHeight="180" DisplayMemberPath="Message" />
              </StackPanel>
            </ScrollViewer>
          </materialDesign:Card>
        </Grid>
      </TabItem>

      <TabItem>
        <TabItem.Header><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="AccountGroupOutline" Margin="0,0,8,0" /><TextBlock Text="Пользователи" /></StackPanel></TabItem.Header>
        <Grid Background="{DynamicResource PageBackgroundBrush}" Style="{StaticResource AnimatedPage}">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <materialDesign:Card Style="{StaticResource Card}" Padding="16" Margin="0,16,0,12">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="UserSearchBox" materialDesign:HintAssist.Hint="ID, username или имя" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Content="Сбросить" Click="ResetUsers_Click" Style="{StaticResource MaterialDesignFlatButton}" />
                  <Button Content="Найти" Click="RefreshUsers_Click" Style="{StaticResource MaterialDesignRaisedButton}" />
                </StackPanel>
              </Grid>
              <Expander Header="Дополнительные фильтры" Margin="4,8,4,0">
                <WrapPanel Margin="0,8,0,0">
                  <TextBox x:Name="UserLanguageBox" Width="120" materialDesign:HintAssist.Hint="Язык" />
                  <ComboBox x:Name="UserStatusBox" Width="180">
                    <ComboBoxItem Content="Любое состояние" IsSelected="True"/><ComboBoxItem Content="Активен"/><ComboBoxItem Content="Бот заблокирован"/><ComboBoxItem Content="Чат недоступен"/>
                  </ComboBox>
                  <DatePicker x:Name="UserActiveAfterBox" Width="170" materialDesign:HintAssist.Hint="Активен после" />
                  <ComboBox x:Name="UserTagBox" Width="170" DisplayMemberPath="Name" materialDesign:HintAssist.Hint="Тег" />
                  <ComboBox x:Name="UserFieldBox" Width="180" DisplayMemberPath="Name" materialDesign:HintAssist.Hint="Поле" />
                  <TextBox x:Name="UserFieldValueBox" Width="160" materialDesign:HintAssist.Hint="Значение" />
                  <ComboBox x:Name="UserSegmentBox" Width="190" DisplayMemberPath="Name" materialDesign:HintAssist.Hint="Сегмент" />
                </WrapPanel>
              </Expander>
            </StackPanel>
          </materialDesign:Card>
          <materialDesign:Card Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <DataGrid x:Name="UsersGrid" IsReadOnly="True" AutoGenerateColumns="False" MouseDoubleClick="UsersGrid_MouseDoubleClick">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Telegram ID" Binding="{Binding TelegramId}" Width="*" />
                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*" />
                <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="*" />
                <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="*" />
                <DataGridTextColumn Header="Язык" Binding="{Binding Language}" Width="*" />
                <DataGridTextColumn Header="Первое взаимодействие" Binding="{Binding FirstSeenAt}" Width="2*" />
                <DataGridTextColumn Header="Последнее взаимодействие" Binding="{Binding LastSeenAt}" Width="2*" />
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </materialDesign:Card>
        </Grid>
      </TabItem>

      <TabItem>
        <TabItem.Header><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="BullhornOutline" Margin="0,0,8,0" /><TextBlock Text="Рассылки" /></StackPanel></TabItem.Header>
        <Grid Background="{DynamicResource PageBackgroundBrush}" Style="{StaticResource AnimatedPage}">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <materialDesign:Card Style="{StaticResource Card}" Margin="0,16,0,12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Новая рассылка" Style="{StaticResource SectionText}" />
                <TextBox x:Name="BroadcastNameBox" Margin="0,16,0,0" materialDesign:HintAssist.Hint="Название рассылки" />
                <TextBox x:Name="BroadcastTextBox" MinHeight="100" AcceptsReturn="True" Margin="0,12,0,0"
                         materialDesign:HintAssist.Hint="Текст сообщения" TextChanged="BroadcastTextBox_TextChanged" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="20,28,0,0" VerticalAlignment="Top">
                <Button Content="Тест выбранному" Click="TestBroadcast_Click" />
                <Button Content="Запустить всем найденным" Click="StartBroadcast_Click" Style="{StaticResource MaterialDesignRaisedButton}" />
              </StackPanel>
            </Grid>
          </materialDesign:Card>
          <materialDesign:Card Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <DataGrid x:Name="BroadcastsGrid" IsReadOnly="True" AutoGenerateColumns="True" />
          </materialDesign:Card>
        </Grid>
      </TabItem>

      <TabItem>
        <TabItem.Header><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ClipboardTextClockOutline" Margin="0,0,8,0" /><TextBlock Text="Журнал" /></StackPanel></TabItem.Header>
        <Grid Background="{DynamicResource PageBackgroundBrush}" Style="{StaticResource AnimatedPage}">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Margin="4,16,4,12">
            <CheckBox x:Name="TechnicalLogBox" Content="Показывать технические сведения" Click="RefreshLogs_Click" VerticalAlignment="Center" />
            <Button Content="Обновить" Click="RefreshLogs_Click" HorizontalAlignment="Right" Style="{StaticResource MaterialDesignOutlinedButton}" />
          </Grid>
          <materialDesign:Card Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <DataGrid x:Name="LogsGrid" IsReadOnly="True" AutoGenerateColumns="True" />
          </materialDesign:Card>
        </Grid>
      </TabItem>

      <TabItem>
        <TabItem.Header><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CogOutline" Margin="0,0,8,0" /><TextBlock Text="Настройки" /></StackPanel></TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource PageBackgroundBrush}" Style="{StaticResource AnimatedPage}">
          <StackPanel MaxWidth="860" HorizontalAlignment="Left" Margin="0,16,0,0">
            <materialDesign:Card Style="{StaticResource Card}" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="Подключение" Style="{StaticResource SectionText}" />
                <ComboBox x:Name="UpdateModeBox" Width="300" HorizontalAlignment="Left" Margin="0,20,0,12">
                  <ComboBoxItem Tag="Webhook" Content="Webhooks" /><ComboBoxItem Tag="LongPolling" Content="Long polling" />
                </ComboBox>
                <Grid Margin="0,4,0,12">
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <Border Padding="16" Margin="0,0,8,0" Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="16">
                    <TextBlock Text="Webhooks — для продакшна, высокой нагрузки и минимальной задержки. Нужны домен и SSL." Style="{StaticResource SupportingText}" />
                  </Border>
                  <Border Grid.Column="1" Padding="16" Margin="8,0,0,0" Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="16">
                    <TextBlock Text="Long polling — для разработки и небольшой нагрузки. Домен и SSL не требуются." Style="{StaticResource SupportingText}" />
                  </Border>
                </Grid>
                <CheckBox x:Name="BotAutoStartBox" Content="Запускать этого бота автоматически" Click="BotAutoStart_Click" Margin="0,8" />
                <CheckBox x:Name="PrivacyModeDisabledBox" Content="Privacy Mode отключён в BotFather" Click="PrivacyModeDisabled_Click" Margin="0,8" />
                <TextBox x:Name="WebhookPublicUrlBox" Margin="0,16,0,0" materialDesign:HintAssist.Hint="Публичный HTTPS-адрес webhook" />
                <TextBlock Text="Локальный адрес Bot.Agent" Style="{StaticResource SupportingText}" Margin="4,12,4,0" />
                <TextBox x:Name="WebhookListenUrlBox" Text="http://localhost:8443" Margin="0,4,0,0" />
                <TextBlock Margin="4,4,4,0" Style="{StaticResource SupportingText}" Text="Туннель должен направлять публичный адрес на локальный. Изменение локального адреса применяется после перезапуска Agent." />
                <Button Content="Сохранить способ получения" HorizontalAlignment="Left" Click="SaveWebhookSettings_Click" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,16,0,0" />
              </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Style="{StaticResource Card}" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="Проект и окно" Style="{StaticResource SectionText}" />
                <StackPanel Orientation="Horizontal" Margin="0,16,0,8">
                  <Button Content="Экспортировать проект" Click="ExportProject_Click" />
                  <Button Content="Импортировать проект" Click="ImportProject_Click" />
                </StackPanel>
                <TextBlock Text="Поведение при закрытии окна" Style="{StaticResource SupportingText}" Margin="4,12,4,0" />
                <ComboBox x:Name="CloseBehaviorBox" MaxWidth="420" HorizontalAlignment="Stretch" Margin="0,4,0,0"
                          SelectionChanged="CloseBehavior_Changed">
                  <ComboBoxItem Tag="ask" Content="Всегда спрашивать" />
                  <ComboBoxItem Tag="background" Content="Продолжать работу в фоне" IsSelected="True" />
                  <ComboBoxItem Tag="exit" Content="Полностью завершать приложение и ботов" />
                </ComboBox>
              </StackPanel>
            </materialDesign:Card>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
