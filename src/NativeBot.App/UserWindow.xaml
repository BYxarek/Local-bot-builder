<Window x:Class="NativeBot.App.UserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пользователь" Height="620" Width="760" WindowStartupLocation="CenterOwner">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" />
    <TextBlock x:Name="SummaryText" Grid.Row="1" Margin="0,8,0,14" TextWrapping="Wrap" />
    <TabControl Grid.Row="2">
      <TabItem Header="История"><DataGrid x:Name="HistoryGrid" IsReadOnly="True" AutoGenerateColumns="True" /></TabItem>
      <TabItem Header="Теги"><DockPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"><TextBox x:Name="TagBox" Width="220"/><Button Content="Добавить" Click="AddTag_Click"/><Button Content="Удалить выбранный" Click="RemoveTag_Click"/></StackPanel><ListBox x:Name="TagsList" /></DockPanel></TabItem>
      <TabItem Header="Поля"><DockPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"><TextBox x:Name="FieldNameBox" Width="130" ToolTip="Название"/><TextBox x:Name="FieldKeyBox" Width="130" ToolTip="Внутренний ключ"/><TextBox x:Name="FieldValueBox" Width="180" ToolTip="Значение"/><Button Content="Сохранить" Click="SaveField_Click"/></StackPanel><DataGrid x:Name="FieldsGrid" IsReadOnly="True" AutoGenerateColumns="True" /></DockPanel></TabItem>
      <TabItem Header="Ожидания"><ListBox x:Name="WaitsList" /></TabItem>
    </TabControl>
  </Grid>
</Window>
