<Window x:Class="NativeBot.App.UserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Пользователь" Height="700" Width="920" MinHeight="560" MinWidth="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Background="{DynamicResource PageBackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Border Padding="24,18" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource MaterialDesign.Brush.Primary.Light}">
          <materialDesign:PackIcon Kind="Account" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light.Foreground}" />
        </Border>
        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Style="{StaticResource AppBarTitleText}" />
          <TextBlock Text="Карточка пользователя" Style="{StaticResource SupportingText}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="24" Style="{StaticResource AnimatedPage}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <materialDesign:Card Style="{StaticResource Card}" Margin="0,0,16,0" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="Сводка" Style="{StaticResource SectionText}" />
          <TextBlock x:Name="SummaryText" Margin="0,16,0,0" Style="{StaticResource SupportingText}" LineHeight="22" />
        </StackPanel>
      </materialDesign:Card>

      <materialDesign:Card Grid.Column="1" Style="{StaticResource Card}" Padding="8">
        <TabControl x:Name="UserTabs">
          <TabItem>
            <TabItem.Header><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="History" Margin="0,0,6,0" /><TextBlock Text="История" /></StackPanel></TabItem.Header>
            <DataGrid x:Name="HistoryGrid" IsReadOnly="True" AutoGenerateColumns="True" Margin="8" />
          </TabItem>
          <TabItem>
            <TabItem.Header><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="TagMultipleOutline" Margin="0,0,6,0" /><TextBlock Text="Теги" /></StackPanel></TabItem.Header>
            <Grid Margin="12" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
              <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <ListBox x:Name="TagsList" />
              <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="TagBox" materialDesign:HintAssist.Hint="Новый тег" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Content="Добавить" Click="AddTag_Click" Style="{StaticResource MaterialDesignRaisedButton}" />
                  <Button Content="Удалить" Click="RemoveTag_Click" />
                </StackPanel>
              </Grid>
            </Grid>
          </TabItem>
          <TabItem>
            <TabItem.Header><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FormTextbox" Margin="0,0,6,0" /><TextBlock Text="Поля" /></StackPanel></TabItem.Header>
            <Grid Margin="12" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
              <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <DataGrid x:Name="FieldsGrid" IsReadOnly="True" AutoGenerateColumns="True" />
              <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="FieldNameBox" materialDesign:HintAssist.Hint="Название" />
                <TextBox x:Name="FieldKeyBox" Grid.Column="1" materialDesign:HintAssist.Hint="Внутренний ключ" />
                <TextBox x:Name="FieldValueBox" Grid.Column="2" materialDesign:HintAssist.Hint="Значение" />
                <Button Grid.Column="3" Content="Сохранить" Click="SaveField_Click" Style="{StaticResource MaterialDesignRaisedButton}" />
              </Grid>
            </Grid>
          </TabItem>
          <TabItem>
            <TabItem.Header><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="TimerSand" Margin="0,0,6,0" /><TextBlock Text="Ожидания" /></StackPanel></TabItem.Header>
            <ListBox x:Name="WaitsList" Margin="12" />
          </TabItem>
        </TabControl>
      </materialDesign:Card>
    </Grid>
  </Grid>
</Window>
