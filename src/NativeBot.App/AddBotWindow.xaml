<Window x:Class="NativeBot.App.AddBotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить бота" Height="620" Width="720" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Токен BotFather" FontSize="20" FontWeight="SemiBold" />
    <PasswordBox x:Name="TokenBox" Grid.Row="1" Margin="0,12,0,8" Padding="8" />
    <CheckBox x:Name="AutoStartBox" Grid.Row="2" Content="Запускать этого бота автоматически" />
    <StackPanel Grid.Row="3" Margin="0,14,0,0">
      <TextBlock Text="Как получать события" FontWeight="SemiBold" />
      <ComboBox x:Name="UpdateModeBox" Width="260" HorizontalAlignment="Left" Margin="0,6,0,0" SelectedIndex="0">
        <ComboBoxItem Tag="Webhook" Content="Webhooks" />
        <ComboBoxItem Tag="LongPolling" Content="Long polling" />
      </ComboBox>
    </StackPanel>
    <Grid Grid.Row="4" Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,14,0">
        <TextBlock Text="Выберите webhooks, если:" FontWeight="SemiBold" />
        <TextBlock Text="☐ Продакшн с высокой нагрузкой (&gt;500 событий/день)&#10;☐ Нужна минимальная латентность&#10;☐ Есть домен и SSL-сертификат&#10;☐ Масштабируемость критична&#10;☐ Платформа рекомендует webhooks" TextWrapping="Wrap" LineHeight="24" Margin="0,6,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="14,0,0,0">
        <TextBlock Text="Выберите long polling, если:" FontWeight="SemiBold" />
        <TextBlock Text="☐ Разработка/тестирование&#10;☐ Нет доступа к домену/SSL&#10;☐ Низкая нагрузка (&lt;500 событий/день)&#10;☐ Один бот без масштабирования&#10;☐ Internal-бот без доступа в интернет" TextWrapping="Wrap" LineHeight="24" Margin="0,6,0,0" />
      </StackPanel>
    </Grid>
    <TextBlock x:Name="StatusText" Grid.Row="5" Margin="0,14,0,0" TextWrapping="Wrap" />
    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Отмена" IsCancel="True" />
      <Button x:Name="ConnectButton" Content="Проверить и добавить" IsDefault="True" Click="Connect_Click" />
    </StackPanel>
  </Grid>
</Window>
