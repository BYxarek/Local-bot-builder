<Window x:Class="NativeBot.App.AddBotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Добавить бота" Height="700" Width="820" MinHeight="620" MinWidth="680"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Background="{DynamicResource PageBackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border Padding="24,0" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <materialDesign:PackIcon Kind="RobotOutline" Width="28" Height="28" Margin="0,0,14,0" />
        <StackPanel>
          <TextBlock Text="Добавить Telegram-бота" Style="{StaticResource AppBarTitleText}" />
          <TextBlock Text="Подключение через токен BotFather" Style="{StaticResource SupportingText}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Style="{StaticResource AnimatedPage}">
      <StackPanel Margin="24" MaxWidth="900">
        <materialDesign:Card Style="{StaticResource Card}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Подключение" Style="{StaticResource SectionText}" />
            <PasswordBox x:Name="TokenBox" Margin="0,20,0,8" materialDesign:HintAssist.Hint="Токен BotFather" />
            <CheckBox x:Name="AutoStartBox" Content="Запускать этого бота автоматически" Margin="0,8,0,0" />
          </StackPanel>
        </materialDesign:Card>

        <materialDesign:Card Style="{StaticResource Card}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Получение событий" Style="{StaticResource SectionText}" />
            <ComboBox x:Name="UpdateModeBox" Width="300" HorizontalAlignment="Left" Margin="0,20,0,16" SelectedIndex="0">
              <ComboBoxItem Tag="Webhook" Content="Webhooks" />
              <ComboBoxItem Tag="LongPolling" Content="Long polling" />
            </ComboBox>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Border Padding="16" Margin="0,0,8,0" Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="16">
                <StackPanel>
                  <TextBlock Text="Webhooks" Style="{StaticResource SectionText}" />
                  <TextBlock Margin="0,8,0,0" Style="{StaticResource SupportingText}"
                             Text="Для продакшна и минимальной задержки. Нужны публичный домен и SSL-сертификат." />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Padding="16" Margin="8,0,0,0" Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="16">
                <StackPanel>
                  <TextBlock Text="Long polling" Style="{StaticResource SectionText}" />
                  <TextBlock Margin="0,8,0,0" Style="{StaticResource SupportingText}"
                             Text="Для разработки, тестов и небольших ботов. Домен и SSL не требуются." />
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </materialDesign:Card>

        <Border x:Name="StatusPanel" Padding="16" CornerRadius="14" Background="{DynamicResource MaterialDesign.Brush.Card.Background}" Visibility="Collapsed">
          <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Padding="20,12" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Отмена" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}" />
        <Button x:Name="ConnectButton" IsDefault="True" Click="Connect_Click" Style="{StaticResource MaterialDesignRaisedButton}">
          <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="LinkVariantPlus" Margin="0,0,8,0" /><TextBlock Text="Проверить и добавить" /></StackPanel>
        </Button>
      </StackPanel>
    </Border>
  </Grid>
</Window>
